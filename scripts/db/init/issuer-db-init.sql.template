-- issuer service db
CREATE DATABASE issuerservice_${ENVIRONMENT};
CREATE USER ${ISSUER_DB_USER} WITH PASSWORD '${ISSUER_DB_USER_PASS}';

    GRANT ALL PRIVILEGES ON DATABASE issuerservice_${ENVIRONMENT} TO ${ISSUER_DB_USER};
    \c issuerservice_${ENVIRONMENT}
    GRANT ALL ON SCHEMA public TO ${ISSUER_DB_USER};

-- issuer-vault db
CREATE DATABASE issuervault_${ENVIRONMENT};
-- we use the same user for vault, not needed to recreate (could be switched to another user)
--CREATE USER ${ISSUER_DB_USER} WITH PASSWORD '${ISSUER_DB_USER_PASS}';

GRANT ALL PRIVILEGES ON DATABASE issuervault_${ENVIRONMENT} TO ${ISSUER_DB_USER};

\c issuervault_${ENVIRONMENT}
GRANT ALL ON SCHEMA public TO ${ISSUER_DB_USER};

-- create vault tables manually
-- vault storage backend
CREATE TABLE vault_kv_store (
  parent_path TEXT COLLATE "C" NOT NULL,
  path        TEXT COLLATE "C",
  key         TEXT COLLATE "C",
  value       BYTEA,
  CONSTRAINT pkey PRIMARY KEY (path, key)
);
CREATE INDEX parent_path_idx ON vault_kv_store (parent_path);

-- vault HAEnabled backend
CREATE TABLE vault_ha_locks (
  ha_key                                      TEXT COLLATE "C" NOT NULL,
  ha_identity                                 TEXT COLLATE "C" NOT NULL,
  ha_value                                    TEXT COLLATE "C",
  valid_until                                 TIMESTAMP WITH TIME ZONE NOT NULL,
  CONSTRAINT ha_key PRIMARY KEY (ha_key)
);	
