-- PROV controlplane db
CREATE DATABASE provider_controlplane_${ENVIRONMENT};
    CREATE USER ${PROVIDER_DB_CP_USER} WITH PASSWORD '${PROVIDER_DB_CP_USER_PASS}';
    GRANT ALL PRIVILEGES ON DATABASE provider_controlplane_${ENVIRONMENT} TO ${PROVIDER_DB_CP_USER};
    \c provider_controlplane_${ENVIRONMENT}
    GRANT ALL ON SCHEMA public TO ${PROVIDER_DB_CP_USER};


-- PROV dataplane db
    CREATE DATABASE provider_dataplane_${ENVIRONMENT};
