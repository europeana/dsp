apiVersion: apps/v1
kind: Deployment
metadata:
  name: vault
  namespace: dsp-issuer-${ENVIRONMENT}
  labels:
    type: edc-infra
spec:
  replicas: 1
  selector:
    matchLabels:
      app: vault
  template:
    metadata:
      labels:
        app: vault
        type: edc-infra
    spec:
      containers:
        - name: vault
          image: hashicorp/vault:2.0.0
          imagePullPolicy: ${IMAGE_PULL_POLICY}
          ports:
            - containerPort: 8200
          securityContext:
            capabilities:
              add:
                - IPC_LOCK
          envFrom:
            - configMapRef: { name: issuervault-env }
          command: ["vault"]
          #a avoid starting in default dev modus, can be switched back by adding -dev to args 
          args:
            - "server"
            - "-config=/vault/config/vault.hcl"
            #- "-dev"
          volumeMounts:
            - name: vault-config
              mountPath: /vault/config/vault.hcl
              subPath: vault.hcl
              readOnly: true
      volumes:
        - name: vault-config
          configMap:
            name: issuervault-config

---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: vault-auth
  namespace: dsp-issuer-${ENVIRONMENT}

---
apiVersion: v1
kind: Secret
metadata:
  name: vault-unseal-key
  namespace: dsp-issuer-${ENVIRONMENT}
type: Opaque
stringData:
  unsealkey: $ISSUER_VAULT_KEY
    
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: issuervault-config
  namespace: dsp-issuer-${ENVIRONMENT}
data: # kv format
  vault.hcl: | 
    storage "postgresql" {
      connection_url = "${ISSUERVAULT_PG_DB_URL}"
    }
    disable_mlock = true
    listener "tcp" {
      # Change default 127.0.0.1:8200 to 0.0.0.0:8200
      address     = "0.0.0.0:8200"
      tls_disable = "true"
    }
  
---
apiVersion: batch/v1
kind: Job
metadata:
  name: vault-bootstrap
  namespace: dsp-issuer-${ENVIRONMENT}
spec:
  backoffLimit: 10
  template:
    metadata:
      labels:
        type: edc-job-${ENVIRONMENT}
    spec:
      serviceAccountName: vault-auth
      restartPolicy: OnFailure
      containers:
        - name: vault-cli
          image: hashicorp/vault:2.0.0
          imagePullPolicy: ${IMAGE_PULL_POLICY}
          env:
            - name: VAULT_ADDR
              value: "http://vault.dsp-issuer-${ENVIRONMENT}.svc.cluster.local:8200"
            - name: VAULT_TOKEN
              value: "root"
            - name: VAULT_UNSEAL_KEY
              valueFrom:
                secretKeyRef:
                  name: vault-unseal-key
                  key: unsealkey  
          securityContext:
            capabilities:
              add:
                - IPC_LOCK
          command: [ "sh", "-ec" ]
          args:
            - |
              #0 Wait for Keycloak to be ready
              echo "Waiting for Keycloak to be ready..."
              until wget -q --spider http://keycloak.dsp-common-${ENVIRONMENT}.svc.cluster.local:8080/realms/mvd/.well-known/openid-configuration > /dev/null 2>&1; do
                echo "Keycloak not ready yet, retrying in 2 seconds..."
                sleep 2
              done
              echo "Keycloak is ready!"
                            
              # Wait for vault to be ready
              echo "Waiting for Vault to be ready..."
              #until vault status > /dev/null 2>&1; do
              #until vault status; do
              #  echo "Vault not ready yet, retrying in 2 seconds..."
              #  sleep 2
              #done
              
              #1. verify if vault status is available
              IS_UP="false"
              VAULT_STATUS=""
              until [ "$IS_UP" = "true" ]; do
                echo "Reading vault status"
                #force returning non error code (true)
                VAULT_STATUS=$(vault status -format=json 2>&1) || true
                echo "$VAULT_STATUS"
                case "$VAULT_STATUS" in
                  "{"*) 
                    echo "Vault is up and responding with valid JSON!"
                    IS_UP="true"
                    ;;
                  *)
                    echo "Vault status not available yet, retrying in 2 seconds..."
                    sleep 2
                    ;;
                esac
              done
              
              #2. verify if initialized 
              IS_INIT=$(echo "$VAULT_STATUS" | grep -o '"initialized": [a-z]*' | cut -d' '-f2)
              IS_SEALED=$(echo "$VAULT_STATUS" | grep -o '"sealed": [a-z]*' | cut -d' ' -f2)
                
              if [ "$IS_INITIALIZED" = "false" ]; then
                echo "Critical Error: Vault is NOT initialized yet. Unseal is not possible."
                echo "Please initialize Vault first using 'vault operator init'."
                exit 1
              elif [ "$IS_INITIALIZED" = "true" ]; then
                echo "Vault is initialized. Proceeding to seal check..."
              else
                echo "Error: Could not parse 'initialized' field (Value: '$IS_INITIALIZED')."
                exit 1
              fi
              
              #3. Unseal Vault
              if [ "$IS_SEALED" = "false" ]; then
                echo "Vault is unsealed."
                exit 0
              elif [ "$IS_SEALED" = "true" ]; then
                echo "Vault is sealed. Initiating unseal process..."
                vault operator unseal "$VAULT_UNSEAL_KEY"
              else
                echo "Error: Could not parse 'sealed' field (Value: '$IS_SEALED')."
                exit 1
              fi
              echo "Vault is ready!"
              
              #4. ensure JWT auth method enabled
              #vault auth enable jwt || true
              AUTH_LIST=$(vault auth list -format=json 2>&1)
              if echo "$AUTH_LIST" | grep -q '"jwt/"'; then
                echo "JWT authentication method allready ENABLED at 'jwt/'."
              else
                vault auth enable jwt
                echo "JWT authentication method ENABLED"
              fi

              #5. Configure JWT auth (example: using Keycloak as JWT backend)
              if vault read auth/jwt/config >/dev/null 2>&1; then
                echo "JWT configuration already exists. Skipping write setup."
              else
                echo "Writing JWT configuration..."
                vault write auth/jwt/config \
                  jwks_url="http://keycloak.dsp-common-${ENVIRONMENT}.svc.cluster.local:8080/realms/mvd/protocol/openid-connect/certs" \
                  default_role="participant" || { echo "Failed to configure JWT auth."; exit 1; }
                
                if [ $? -ne 0 ]; then
                  echo "Critical Error: Failed to configure JWT auth."
                  exit 1
                fi  
                  
              fi    
              
              #6. ensure mount for participants, each stores their secrets in a subdirectory
              #vault secrets enable -path=participants -version=2 kv || { echo "Failed to enable secrets engine: : Need to ad back exit 1"; }
              if vault secrets list -format=json | grep -q '"participants/"'; then
                echo "Secrets engine at path 'participants/' already exists. Skipping setup."
              else
                vault secrets enable -path=participants -version=2 kv
                if [ $? -eq 0 ]; then
                  echo "Successfully enabled KV-V2 secrets engine at path 'participants/'."
                else
                  echo "Critical Error: Failed to enable secrets engine at path 'participants/'."
                  exit 1
                fi
              fi    
              
              #7. get accessor for entity aliases
              ACCESSOR=$(vault auth list | grep 'jwt/' | awk '{print $3}')
              if [ -z "$ACCESSOR" ]; then
                echo "Failed to get JWT accessor"
                exit 1
              fi
              echo "Using JWT accessor: $ACCESSOR"


              #8. Ensure full CRUD + list on the participant's own data path
              # vault write behaves as create or update
              cat <<"EOF" | vault policy write participants-restricted - || { echo "Failed to write policy"; exit 1; }
              path "participants/data/{{identity.entity.aliases.${ACCESSOR}.name}}/*" {
                  capabilities = ["create", "read", "update", "delete", "list"]
              }

              path "participants/metadata/{{identity.entity.aliases.${ACCESSOR}.name}}/*" {
                   capabilities = ["list"]
              }
              EOF

              #9. Create or update the 'participant' Role
              # vault write behaves as create or update
              vault write auth/jwt/role/participant -<<EOF || { echo "Failed to create JWT role"; exit 1; }
              {
                "role_type": "jwt",
                "user_claim": "participant_context_id",
                "bound_issuer": "http://vault.dsp-issuer-${ENVIRONMENT}.localhost/realms/mvd",
                "bound_claims": {
                  "role": "participant"
                },
                "token_policies": ["participants-restricted"],
                "clock_skew_leeway": 60
              }
              EOF
              
              
              # 10. Allow full CRUD + list for provisioner
              cat <<"EOF" | vault policy write provisioner-policy - || { echo "Failed to write policy"; exit 1; }
              path "*" {
                capabilities = ["create", "read", "update", "delete", "list", "sudo"]
              }
              
              path "sys/*" {
                capabilities = ["create", "read", "update", "delete", "list", "sudo"]
              }
              EOF
              
              # 11. Create or update 'provisioner' role 
              vault write auth/jwt/role/provisioner -<<EOF || { echo "Failed to create provisioner JWT role"; exit 1; }
              {
                "role_type": "jwt",
                "user_claim": "azp",
                "bound_issuer": "http://vault.dsp-issuer-${ENVIRONMENT}.localhost/realms/mvd",
                "bound_claims": {
                  "role": "provisioner"
                },
                "token_policies": ["provisioner-policy"],
                "clock_skew_leeway": 60
              }
              EOF
              
              # 12. Create or update 'AES' key
              vault write secret/data/aes-key-alias -<<EOF || { echo "Failed to create ase key entry"; exit 1; }
              {
                "data": {
                  "content": "yHo9w6m2KOI3FE7vI+fcN6j86JDQ6V10lJPlv9lLWoE="
                }
              }
              EOF
              
              echo "Vault bootstrap completed successfully!"


---
apiVersion: v1
kind: Service
metadata:
  name: vault
  namespace: dsp-issuer-${ENVIRONMENT}
spec:
  selector:
    app: vault
  ports:
    - port: 8200
      targetPort: 8200

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: vault
  namespace: dsp-issuer-${ENVIRONMENT}
spec:
  parentRefs:
    - name: consumer-gateway
  hostnames:
    - vault.dsp-provider-${ENVIRONMENT}.localhost
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: vault
          port: 8200