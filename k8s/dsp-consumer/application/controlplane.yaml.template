apiVersion: apps/v1
kind: Deployment
metadata:
  name: controlplane
  namespace: consumer-${ENVIRONMENT}
  labels:
    app: controlplane
    type: edc-app
spec:
  replicas: 1
  selector:
    matchLabels:
      app: controlplane
  template:
    metadata:
      name: controlplane
      labels:
        app: controlplane
        platform: edcv
        type: edc-app
    spec:
      containers:
        - name: controlplane
          image: ghcr.io/eclipse-edc/minimumviabledataspace/controlplane:${MVD_IMAGE_TAG}
          imagePullPolicy: ${IMAGE_PULL_POLICY}
          envFrom:
            - configMapRef: { name: controlplane-config }
          ports:
            - containerPort: 1044
              name: debug-port
          livenessProbe:
            httpGet:
              path: /api/check/liveness
              port: 8080
            failureThreshold: 10
            periodSeconds: 5
            timeoutSeconds: 120
          readinessProbe:
            httpGet:
              path: /api/check/readiness
              port: 8080
            failureThreshold: 10
            periodSeconds: 5
            timeoutSeconds: 120
          startupProbe:
            httpGet:
              path: /api/check/startup
              port: 8080
            failureThreshold: 10
            periodSeconds: 5
            timeoutSeconds: 120
      restartPolicy: Always

---
apiVersion: v1
kind: Service
metadata:
  name: controlplane
  namespace: consumer-${ENVIRONMENT}
spec:
  type: ClusterIP
  selector:
    app: controlplane
  ports:
    - name: health
      port: 8080
      targetPort: 8080
    - name: management
      port: 8081
      targetPort: 8081
    - name: protocol
      port: 8082
      targetPort: 8082
    - name: control
      port: 8083
      targetPort: 8083
    - name: debug
      port: 1044
      targetPort: 1044

---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: consumer-cors-middleware
  namespace: consumer-${ENVIRONMENT}
spec:
  headers:
    accessControlAllowMethods:
      - "GET"
      - "OPTIONS"
      - "PUT"
      - "DELETE"
      - "POST"
    #  - "*"
    accessControlAllowHeaders:
      - "*"
    #  - "Authorization"
    #  - "Content-Type"
    #  - "Origin"
    #  - "Cookie"
    #  - "x-api-key"
    accessControlAllowOriginList:
      - "*"
      #- "${DSP_DASHBOARD_HOST}"
    accessControlExposeHeaders:
      - "*"
    accessControlMaxAge: 3600
    addVaryHeader: true


---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: controlplane
  namespace: consumer-${ENVIRONMENT}
spec:
  parentRefs:
    - name: consumer-gateway
      kind: Gateway
      namespace: consumer-${ENVIRONMENT}
#      sectionName: web
  hostnames:
    - cp.consumer-${ENVIRONMENT}.localhost
    - cp-consumer-${ENVIRONMENT}.${DEPLOYMENT_BASE_URL}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      filters:
      #SG: apply CORS Midleware to all paths
        - type: ExtensionRef
          extensionRef:
            group:  traefik.io
            kind: Middleware
            name: consumer-cors-middleware
      backendRefs:
        - name: controlplane
          port: 8081
          weight: 1
    - matches:
        - path:
            type: PathPrefix
            value: /management
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /api/mgmt     
      #SG: apply CORS Midleware to all paths
        - type: ExtensionRef
          extensionRef:
            group:  traefik.io
            kind: Middleware
            name: consumer-cors-middleware
      backendRefs:
        - name: controlplane
          port: 8081
          weight: 1
    - matches:
        - path:
            type: PathPrefix
            value: /api/check/
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /api/check/     
      #SG: apply CORS Midleware to all paths
        - type: ExtensionRef
          extensionRef:
            group:  traefik.io
            kind: Middleware
            name: consumer-cors-middleware
      backendRefs:
        - name: controlplane
          port: 8080
          weight: 1
     
    - matches:
        - path:
            type: PathPrefix
            value: /api/dsp
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /api/dsp     
      #SG: apply CORS Midleware to all paths
        - type: ExtensionRef
          extensionRef:
            group:  traefik.io
            kind: Middleware
            name: consumer-cors-middleware
      backendRefs:
        - name: controlplane
          port: 8082
          weight: 1
     
    - matches:
        - path:
            type: PathPrefix
            value: /api/control
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /api/control     
      #SG: apply CORS Midleware to all paths
        - type: ExtensionRef
          extensionRef:
            group:  traefik.io
            kind: Middleware
            name: consumer-cors-middleware
      backendRefs:
        - name: controlplane
          port: 8083
          weight: 1
 
    - matches:
        - path:
            type: PathPrefix
            value: /api/check/
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /api/check/     
      #SG: apply CORS Midleware to all paths
        - type: ExtensionRef
          extensionRef:
            group:  traefik.io
            kind: Middleware
            name: consumer-cors-middleware
      backendRefs:
        - name: controlplane
          port: 8080
          weight: 1
 
