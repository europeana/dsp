---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dataplane-config
  namespace: consumer-${ENVIRONMENT}
data:
  edc.hostname: "dataplane.consumer-${ENVIRONMENT}.svc.cluster.local"
  dataplane.id: "consumer-dataplane"
  edc.transfer.proxy.token.verifier.publickey.alias: "dataplane-private"
  edc.transfer.proxy.token.signer.privatekey.alias: "dataplane-public"

  edc.dpf.selector.url: "http://controlplane.consumer-${ENVIRONMENT}.svc.cluster.local:8083/api/control/v1/dataplanes"

  web.http.port: "8080"
  web.http.path: "/api"
  web.http.signaling.port: "8182"
  web.http.signaling.path: "/api/signaling"

  web.http.public.port: "11002"
  web.http.public.path: "/api/public"

  web.http.proxy.port: "11003"
  web.http.proxy.path: "/api/proxy"

  edc.vault.hashicorp.url: "http://vault.consumer-${ENVIRONMENT}.svc.cluster.local:8200"
  edc.vault.hashicorp.token: "root"

  JAVA_TOOL_OPTIONS: "-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=1044"
  #OTEL_EXPORTER_OTLP_ENDPOINT: "${ELASTIC_APM_SERVERS}"
  #OTEL_EXPORTER_OTLP_PROTOCOL: "http/protobuf"
  #OTEL_EXPORTER_OTLP_HEADERS: "Authorization=Bearer your_apm_secret_token"
  #OTEL_RESOURCE_ATTRIBUTES: "service.name=dp-consumer-${ENVIRONMENT},deployment.environment=${ENVIRONMENT}"
  
  edc.datasource.default.url: "jdbc:postgresql://postgres.consumer-${ENVIRONMENT}.svc.cluster.local:5432/dataplane"
  edc.datasource.default.user: "dp"
  edc.datasource.default.password: "dp"
  edc.sql.schema.autocreate: "true"
