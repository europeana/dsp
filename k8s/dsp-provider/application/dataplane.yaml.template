---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dataplane
  namespace: provider-${ENVIRONMENT}
  labels:
    app: dataplane
    type: edcv-app
spec:
  replicas: 1
  selector:
    matchLabels:
      app: dataplane
  template:
    metadata:
      labels:
        app: dataplane
        platform: edcv
        type: edcv-app
    spec:
      containers:
        - name: dataplane
          image: ghcr.io/eclipse-edc/minimumviabledataspace/dataplane:${MVD_IMAGE_TAG}
          imagePullPolicy: ${IMAGE_PULL_POLICY}
          envFrom:
            - configMapRef:
                name: dataplane-config
          ports:
            - containerPort: 1044
              name: debug-port
            - containerPort: 8182
              name: signaling-port
          livenessProbe:
            httpGet:
              path: /api/check/liveness
              port: 8080
            failureThreshold: 30
            periodSeconds: 10
            timeoutSeconds: 60
          readinessProbe:
            httpGet:
              path: /api/check/readiness
              port: 8080
            failureThreshold: 30
            periodSeconds: 10
            timeoutSeconds: 60
          startupProbe:
            httpGet:
              path: /api/check/startup
              port: 8080
            failureThreshold: 30
            periodSeconds: 10
            timeoutSeconds: 60

---
apiVersion: v1
kind: Service
metadata:
  name: dataplane
  namespace: provider-${ENVIRONMENT}
spec:
  type: ClusterIP
  selector:
    app: dataplane
  ports:
    - name: health
      port: 8080
      targetPort: 8080
    - name: public
      port: 11002
      targetPort: 11002
    - name: signaling
      port: 8182
      targetPort: 8182
    - name: proxy
      port: 11003
      targetPort: 11003

---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: httproute-dataplane
  namespace: provider-${ENVIRONMENT}
spec:
  parentRefs:
    - name: provider-gateway
      namespace: provider-${ENVIRONMENT}
  hostnames:
    - dp.provider-${ENVIRONMENT}.localhost
    - dp-provider-${ENVIRONMENT}.${DEPLOYMENT_BASE_URL}
  rules:
    # /api/public → public port 11002
    - matches:
        - path:
            type: PathPrefix
            value: /
      filters:
        - type: URLRewrite
          urlRewrite:
            path:
              type: ReplacePrefixMatch
              replacePrefixMatch: /
      backendRefs:
        - name: dataplane
          port: 11002
          weight: 1